# Local development only. Copy to .env; these are synthetic example values, not
# deployable credentials. Never commit a populated .env file.
# DATABASE_URL is the runtime URL (use a TLS pooled URL in production).
# DIRECT_URL is for Prisma CLI migrations/admin tasks (use a TLS direct/session URL).
DATABASE_URL="postgresql://aurelia_dev:aurelia_local_password@localhost:5434/aurelia_studio_dev?schema=public"
DIRECT_URL="postgresql://aurelia_dev:aurelia_local_password@localhost:5434/aurelia_studio_dev?schema=public"

# Optional bounded runtime pool settings.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# Generate independent high-entropy values for each preview/production environment.
# AUTH_SECRET signs Auth.js state. RATE_LIMIT_SECRET must be at least 32 characters.
AUTH_SECRET=
RATE_LIMIT_SECRET=

# Development administrator provisioning inputs. Never commit populated values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production provisioning additionally requires both exact guard values:
# ADMIN_PROVISION_MODE=production
# ADMIN_PROVISION_CONFIRM=PROVISION_AURELIA_ADMIN_IN_PRODUCTION
